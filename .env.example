# Copy to .env.local for local dev and add the same vars in the Vercel dashboard.
# All three services have a free tier — nothing here costs money.

# --- MongoDB Atlas (free M0 cluster) ---
# Atlas > Connect > Drivers. Add your IP (or 0.0.0.0/0 for dev) to Network Access.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="dsa_studio"

# --- Clerk (free tier) ---
# Clerk dashboard > API keys. The publishable key is exposed to the browser (VITE_ prefix).
VITE_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
